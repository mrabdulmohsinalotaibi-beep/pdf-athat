{
  "name": "pdf-athat-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "PDF.ATHAT offline desktop application",
  "main": "main.cjs",
  "scripts": {
    "build:offline": "node scripts/build-offline.cjs",
    "start": "npm run build:offline && electron .",
    "dist:win": "npm run build:offline && electron-builder --win nsis portable",
    "dist:linux": "npm run build:offline && electron-builder --linux AppImage",
    "dist:mac": "npm run build:offline && electron-builder --mac dmg",
    "test:offline": "npm run build:offline && node --check main.cjs && node --check scripts/build-offline.cjs && node scripts/check-module.cjs && node scripts/test-offline.cjs && node scripts/test-pdf-engine.cjs"
  },
  "dependencies": {
    "pdfjs-dist": "5.4.394",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "app.athat.pdf",
    "productName": "PDF.ATHAT",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    }
  }
}
